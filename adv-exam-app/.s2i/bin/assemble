#!/bin/bash

echo "Custom assemble starting..."

cp -R /tmp/src/* /opt/app-root/src/
cd /opt/app-root/src/

echo "Installing dependencies..."
pip install --no-cache-dir -r requirements.txt

echo "Preparing initial data..."
if [ -f data/sample.json ]; then
    cp data/sample.json /tmp/data.json
fi

chown -R 1001:0 /opt/app-root/src

echo "Assemble completed"